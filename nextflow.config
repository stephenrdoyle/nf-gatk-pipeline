/*
 * nextflow.config
 * Sanger farm22 / LSF / scratch127
 *
 * Resource labels
 * ---------------
 * process_low    : interval generation, indexing            (4 GB,  2h)
 * process_medium : HaplotypeCaller, GatherVcfs              (32 GB, 12h)
 * process_high   : GenomicsDBImport, GenotypeGVCFs          (32 GB, 24h)
 *
 * Memory and time scale with task.attempt on retry; the LSF queue is chosen
 * from the requested time (normal <= 12h, long <= 48h, else week).
 * With 10 Mb intervals, GenomicsDB and Genotype jobs should comfortably
 * fit within 32 GB for a 600-sample cohort. Retry scaling is kept as
 * insurance.
 *
 * Executor
 * --------
 * LSF is the default executor (set below at top level), so a bare
 * `nextflow run main.nf ...` submits to LSF without needing -profile.
 * `-profile local` is kept as an explicit opt-out for small local tests
 * (e.g. running MAKE_INTERVALS or a single-sample smoke test on the head
 * node) — it should not be used for real cohort runs.
 */

manifest {
    name        = 'nf-gatk-pipeline'
    description = 'H. contortus WGS variant calling — interval-scatter design'
    version     = '2.0.0'
}

// The only place parameter defaults are defined (main.nf reads them from here)
params {
    // Inputs (required)
    samplesheet               = null       // CSV: sample_id,bam[,bai]
    reference                 = null       // FASTA; .fai/.dict are created beside it

    outdir                    = 'results'
    window_size               = 10_000_000 // interval-scatter window (bp)
    cleanup                   = false      // empty intermediate work dirs at the end

    // Genotyping mode
    use_gnarly                = false
    dragen_mode               = false      // DRAGEN-GATK: DRAGstr calibration, HC --dragen-mode,
                                           // DRAGEN QUAL filter in hard filter mode
    pooled                    = false

    // Genotype-level filters
    genotype_dp_threshold     = 5
    genotype_gq_threshold     = 20
    genotype_rgq_threshold    = null

    // Variant filter mode: 'hard', 'optimised', or 'custom'
    filter_mode               = 'hard'
    filter_percentile_lo      = 5          // optimised mode
    snp_filters               = null       // custom mode, e.g. "QD < 2.0,FS > 60.0"
    indel_filters             = null       // custom mode

    // Pool annotation (pooled mode only)
    pool_het_lo               = 0.05
    pool_het_hi               = 0.95
    pool_hom_alt_lo           = 0.95
}

// ---------------------------------------------------------------------------
// Executor — LSF is the default, not opt-in
// ---------------------------------------------------------------------------
process.executor = 'lsf'

executor {
    queueSize       = 1000
    submitRateLimit = '200/1min'
    pollInterval    = '30 sec'
    perJobMemLimit  = true
    // How long to wait for a finished job's .exitcode to appear before
    // declaring it failed with no exit status (default 270 sec). Lustre can
    // lag well beyond that, failing jobs that actually completed.
    exitReadTimeout = '10 min'
}

// ---------------------------------------------------------------------------
// Profiles — 'local' is now an explicit opt-out for small/test runs only
// ---------------------------------------------------------------------------
profiles {
    local {
        process.executor = 'local'
    }
}

// ---------------------------------------------------------------------------
// Process defaults and retry logic
// ---------------------------------------------------------------------------
process {

    beforeScript = '''
        source /etc/profile.d/modules.sh
        module unload samtools bcftools gatk
        module load gatk/4.6.1.0
        module load samtools/1.21
        module load bcftools-1.19/python-3.11.6
    '''

    cache       = 'lenient'

    // farm22 requires -M and rusage[mem=] to match exactly.
    // Combine mem selection with ut<1.0 to avoid overloaded nodes.
    clusterOptions = { "-R \"select[ut<1.0]\"" }

    // Exit codes seen on farm22 / LSF and what they mean:
    //   no code    Nextflow never got an exit status: the job died without
    //              writing .exitcode (Lustre client eviction — 'Cannot send
    //              after transport endpoint shutdown'), or finished but the
    //              file never appeared on Lustre. Nextflow reports this as
    //              Integer.MAX_VALUE ('-' in the trace / nextflow log), not
    //              null — checking only for null let these fall through to
    //              'ignore' and silently dropped samples from GenomicsDB groups.
    //   -1         Nextflow could not read the exit status
    //   130        TERM_MEMLIMIT  — LSF killed the job for exceeding -M
    //   140        TERM_RUNLIMIT  — LSF killed the job at its -W wall time
    //   137, 143   SIGKILL / SIGTERM — external kill (node eviction, preemption)
    //   134, 135,  SIGABRT / SIGBUS / SIGSEGV — JVM or native crash
    //   139        (e.g. Intel GKL on Lustre)
    //   250        GenomicsDB / TileDB native failure
    // All of these retry. Memory and time scale with task.attempt, and the
    // queue below follows the time, so every retry gets more of both.
    // The two long GATK steps (GENOMICS_DB_IMPORT, GENOTYPE_GVCFS) also retry
    // exit 1 — see their overrides below.
    //
    // Per-task exit codes, attempts and the action taken are recorded in the
    // trace file (see 'Reporting' at the end of this file).
    errorStrategy = {
        if (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE) return 'retry'
        if (task.exitStatus in [-1, 130, 134, 135, 137, 139, 140, 143, 250]) return 'retry'
        // Anything else is a real failure. 'finish' lets running jobs complete,
        // then stops the run with an error — never 'ignore', which drops the
        // task's output and lets downstream steps run on an incomplete set
        // (e.g. a sample missing from a GenomicsDB group, or a 10 Mb window
        // missing from the cohort VCF) while the run still reports success.
        return 'finish'
    }
    maxRetries = 3

    // Queue follows the requested wall time, so a retry that doubles the time
    // moves up a queue instead of being rejected by bsub for exceeding the
    // queue's run limit. farm22 run limits: normal 12h, long 48h, week 7d.
    // Per-process blocks below set time only — never a fixed queue.
    queue = { !task.time || task.time <= 12.h ? 'normal' : task.time <= 48.h ? 'long' : 'week' }

    // --- Labels ---

    withLabel: process_low {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withLabel: process_high {
        // GenomicsDBImport and GenotypeGVCFs — 24h start (long queue)
        // because even 10 Mb intervals with 600 samples can take >12h
        // on a loaded farm; promotes to higher memory on retry.
        cpus   = 8
        memory = { 32.GB * task.attempt }  // 32 → 64 → 96 GB
        time   = { 24.h  * task.attempt }  // 24h long → 48h long → 72h+ week
    }

    // --- Per-process overrides ---

    withName: MAKE_INTERVALS {
        // Trivially fast; override to minimal resources
        label  = 'process_low'
        cpus   = 1
        memory = 2.GB
        time   = 30.min
    }

    withName: 'HAPLOTYPE_CALLER|HAPLOTYPE_CALLER_DRAGEN' {
        // 10 Mb interval + 200 bp padding: modest memory requirement
        // Retry bumps memory and time (8h normal → 16h long)
        cpus   = 4
        memory = { 16.GB * task.attempt }  // 16 → 32 → 48 GB
        time   = { 8.h   * task.attempt }
    }

    withName: 'COMPOSE_STR_TABLE|CALIBRATE_DRAGSTR' {
        // --dragen_mode only. Both are single-threaded GATK tools: the STR
        // table runs once on the reference; calibration samples STR sites
        // from each BAM. Modules set -Xmx to task.memory - 4 GB.
        cpus   = 1
        memory = { 8.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: GENOMICS_DB_IMPORT {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        // Exit 1 here is usually a clean external kill (Lustre drop, node
        // eviction) with no GATK exception logged — worth retrying rather
        // than losing hours of import progress. Each retry attempt gets a
        // fresh work directory from Nextflow, so the corrupt/incomplete
        // GenomicsDB workspace from the failed attempt is simply abandoned
        // (not reused) — no manual cleanup needed inside this closure.
        errorStrategy = {
            if (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE) return 'retry'
            if (task.exitStatus in [-1, 1, 130, 134, 135, 137, 139, 140, 143, 250]) return 'retry'
            return 'finish'
        }
    }

    withName: GENOTYPE_GVCFS {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        // SIGBUS from Intel GKL on Lustre often surfaces as a masked exit 1
        // (transport shutdown overwrites the real signal) — retry rather
        // than losing a long-running job.
        errorStrategy = {
            if (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE) return 'retry'
            if (task.exitStatus in [-1, 1, 130, 134, 135, 137, 139, 140, 143, 250]) return 'retry'
            return 'finish'
        }
    }

    withName: GATHER_VCFS {
        // concat --naive + reheader: streams compressed blocks, no sort,
        // so it is I/O-bound and needs little memory or CPU
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    // --- Post-calling steps on the whole-genome cohort VCF ---
    // GATK steps here are single-threaded, so 1 CPU; each module sets
    // -Xmx to task.memory - 4 GB, so memory must stay >= 8 GB.

    withName: GENOTYPE_FILTER {
        // VariantFiltration on whole-genome cohort VCF takes 2-4h
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: SPLIT_VARIANTS {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: MERGE_FILTERED {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: 'HARD_FILTER|CUSTOM_FILTER' {
        // VariantFiltration streams the SNP or indel VCF: little memory,
        // but hours on a whole-genome cohort (was process_low: 4 GB / 2h)
        cpus   = 1
        memory = { 8.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: OPTIMISED_FILTER {
        // optimised_filter.py holds every annotation value in memory, so
        // keep 32 GB; VariantsToTable/VariantFiltration are single-threaded
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: POOL_ANNOTATE {
        // pool_annotate.py rewrites every genotype line by line: low memory,
        // slow on a whole-genome cohort (was process_low: 2h)
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: SAMPLE_MISSINGNESS {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: FILTER_SUMMARY {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: BCFTOOLS_STATS_RAW {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: BCFTOOLS_STATS_FILTERED {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }
}

// ---------------------------------------------------------------------------
// Scratch / working directory
// ---------------------------------------------------------------------------
// Working directory — always relative to wherever the pipeline is launched from
workDir = "${System.getProperty('user.dir')}/work"

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_timeline.html"
}
// One row per task attempt: exit code, attempt number, what errorStrategy
// decided (error_action), resources asked for vs used, and the work dir.
// Timestamped so a -resume run doesn't overwrite the trace of the run that
// failed. Find failures with:
//   awk -F'\t' 'NR==1 || ($5 != "COMPLETED" && $5 != "CACHED")' results/pipeline_trace_*.txt
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
    fields  = 'task_id,hash,native_id,name,status,exit,attempt,error_action,queue,cpus,memory,peak_rss,time,realtime,workdir'
}
